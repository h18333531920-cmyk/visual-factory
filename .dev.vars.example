# Local-only Cloudflare Pages Functions configuration.
#
# 1. Copy this file to .dev.vars.
# 2. Fill only the values you received through an approved secure channel.
# 3. Never commit .dev.vars or paste any value into chat, GitHub, or frontend code.
#
# The public Supabase values below are included for local convenience. Every value
# marked <REQUIRED_SECRET> must stay local or in Cloudflare Pages encrypted secrets.

SUPABASE_URL=https://juuqvjmhzdgfggzrivbb.supabase.co
SUPABASE_ANON_KEY=sb_publishable_PIa3V0LGlOn1K6G1nBUeqw_kiFB6fjt
SUPABASE_SERVICE_ROLE_KEY=<REQUIRED_SECRET>

# GPT image/text through MochEN AI (recommended current GPT route)
LK888_API_KEY=<REQUIRED_SECRET>
LK888_BASE_URL=https://api.lk888.ai
LK888_IMAGE_MODEL=gpt-image-2
LK888_TEXT_MODEL=gpt-5.5

# Official OpenAI fallback. It can be unavailable by request region, so the
# application automatically falls back to Volc when that particular error occurs.
OPENAI_API_KEY=<REQUIRED_SECRET>
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_TEXT_MODEL=gpt-5.4-mini

# Volc image generation and image-to-image
VOLC_API_KEY=<REQUIRED_SECRET>
ENDPOINT_ID=<REQUIRED_SECRET>
# Leave blank to reuse ENDPOINT_ID. Set only when Volc provides a dedicated I2I endpoint.
VOLC_I2I_ENDPOINT_ID=

# Volc outpainting
VOLC_ACCESS_KEY_ID=<REQUIRED_SECRET>
VOLC_SECRET_ACCESS_KEY=<REQUIRED_SECRET>
